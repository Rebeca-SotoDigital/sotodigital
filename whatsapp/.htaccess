# Proteger credenciales de WhatsApp
<Files "whatsapp-config.php">
    Require all denied
</Files>

# Proteger archivos de diagnóstico y registros
<FilesMatch "^(errores-whatsapp|control-[^/]*|diagnostico-[^/]*|resultado-envio|analisis-mensaje)\.txt$">
    Require all denied
</FilesMatch>

# Evitar mostrar listados de directorios
Options -Indexes


# Proteger las credenciales de Anthropic
<Files "anthropic-config.php">
    Require all denied
</Files>


# Soto Digital - Seguridad del agente WhatsApp

# Bloquear acceso HTTP directo a los archivos
# internos, scripts de pruebas y configuraciones.
# Solo permitir las entradas públicas necesarias.
<FilesMatch "^(?!(?:index|webhook|webhook-agent|worker-agent)\.php$).+\.php$">
    Require all denied
</FilesMatch>

# Proteger archivos de datos y bloqueo.
<FilesMatch "\.(json|lock|log|bak|sql|env)$">
    Require all denied
</FilesMatch>

Options -Indexes
