Options -Indexes

# Canonical production domain. Local development hosts are unaffected.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|tools|docs)(/|$) - [R=404,L]
    RewriteRule ^[^/]*\.md$ - [R=404,L,NC]
    RewriteRule \.(py|sqlite3?|log|bak|sql|ini)$ - [R=404,L,NC]
    RewriteRule (^|/)\.(ht|git|DS_Store) - [R=404,L]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?soto-digital\.com(?::[0-9]+)?$ [NC]
    RewriteCond %{THE_REQUEST} "\s/+index\.php(?:[?\s])" [NC]
    RewriteRule ^index\.php$ https://soto-digital.com/ [R=301,L]

    RewriteCond %{HTTP_HOST} ^(?:www\.)?soto-digital\.com(?::[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.soto-digital\.com [NC]
    RewriteRule ^ https://soto-digital.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Text compression. These guards allow hosts without optional modules to keep
# serving the site; check Content-Encoding on the production host after upload.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json application/ld+json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Enable only after production HTTPS and redirects have been verified:
    # Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://sc.lftracker.com; connect-src 'self' https://challenges.cloudflare.com https://*.google-analytics.com https://*.analytics.google.com https://*.googleadservices.com https://googleads.g.doubleclick.net https://*.lftracker.com; img-src 'self' data: https://*.google-analytics.com https://*.google.com https://*.google.es https://*.googleadservices.com https://googleads.g.doubleclick.net https://*.lftracker.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src https://challenges.cloudflare.com https://www.googletagmanager.com; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'"

    # Clear both Apache header tables before setting one final policy.
    Header unset Cache-Control
    Header always unset Cache-Control
    Header always set Cache-Control "no-cache"
    <FilesMatch "\.(?:css|js|png|jpe?g|webp|avif|gif|svg|ico|woff2)$">
        Header always set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.[a-f0-9]{12}\.(?:css|js|woff2)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
